# Modal CLI authentication
#
# Interactive users can run `uv run modal setup` instead of using this file.
# For headless or project-scoped authentication, copy this file to `.env`,
# replace both placeholders, and load it into the current shell as documented in
# `docs/running-modal.md`. Never commit the populated `.env` file.

MODAL_TOKEN_ID=replace-with-your-modal-token-id
MODAL_TOKEN_SECRET=replace-with-your-modal-token-secret

# Optional: uncomment this only when you want to target a named Modal Environment.
# If omitted, Modal uses the active profile or workspace default.
# MODAL_ENVIRONMENT=main
